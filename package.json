{
  "name": "creama",
  "version": "0.1.0",
  "private": true,
  "description": "Connect Postgres. AI proposes your business metrics with evidence. Humans certify what's true. Software and AI reuse it.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "creama": "./bin/creama.ts"
  },
  "scripts": {
    "dev": "tsx bin/migrate.ts && next dev --port 3300",
    "build": "next build",
    "start": "next start --port 3300",
    "demo:db": "bash demo/setup.sh",
    "creama": "tsx bin/creama.ts",
    "mcp": "tsx bin/creama.ts mcp",
    "worker": "tsx bin/worker.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "tsx bin/migrate.ts",
    "auth:schema": "tsx bin/auth-schema.ts"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@better-auth/cimd": "1.7.7",
    "@better-auth/mcp": "1.7.7",
    "@better-auth/oauth-provider": "1.7.7",
    "@google/genai": "2.28.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "better-auth": "1.7.7",
    "next": "16.4.0",
    "pg": "8.23.1",
    "pg-boss": "12.37.1",
    "pgsql-ast-parser": "12.0.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsx": "4.23.15",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@playwright/test": "1.64.0",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vitest": "5.0.3"
  }
}
