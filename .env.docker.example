# Copy to .env.docker.local (ignored); do not use the database's real production credentials.
# Generate each value separately with: openssl rand -hex 32
# POSTGRES_PASSWORD must be URL-safe (hex is safe).
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=
CREMA_ENCRYPTION_KEY=
# Optional. The first admin uses the one-time setup link the web service prints in its log
# (or `crema setup-link`). Set this only if you prefer a fixed setup secret instead.
# CREMA_SETUP_TOKEN=
APP_URL=http://localhost:3300
CREMA_PROVIDER=google
CREMA_MODEL=gemini-3.8-flash
GEMINI_API_KEY=
# OPENAI_API_KEY=
# XAI_API_KEY=
# ANTHROPIC_API_KEY=
# Bundled hosting server (databases Crema creates for apps). URL-safe values (hex).
HOSTING_SUPERUSER_PASSWORD=
HOSTING_PROVISIONER_PASSWORD=
# The host:port apps use to reach it (your server's address and CREMA_HOSTING_PORT).
CREMA_HOSTING_PUBLIC_HOST=localhost:5433
# CREMA_HOSTING_PORT=5433
# CREMA_HOSTING_BIND=0.0.0.0
