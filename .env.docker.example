# Copy to .env.docker.local (ignored); do not use the database's real production credentials.
# Generate each value separately with: openssl rand -hex 32
# POSTGRES_PASSWORD must be URL-safe (hex is safe).
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=
CREAMA_ENCRYPTION_KEY=
# Required for first-account setup when APP_URL is a public domain.
CREAMA_SETUP_TOKEN=
APP_URL=http://localhost:3300
CREAMA_PROVIDER=google
CREAMA_MODEL=gemini-3.8-flash
GEMINI_API_KEY=
# OPENAI_API_KEY=
# XAI_API_KEY=
# ANTHROPIC_API_KEY=
# Bundled hosting server (databases Creama creates for apps). URL-safe values (hex).
HOSTING_SUPERUSER_PASSWORD=
HOSTING_PROVISIONER_PASSWORD=
# The host:port apps use to reach it (your server's address and CREAMA_HOSTING_PORT).
CREAMA_HOSTING_PUBLIC_HOST=localhost:5433
# CREAMA_HOSTING_PORT=5433
# CREAMA_HOSTING_BIND=0.0.0.0
