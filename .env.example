# Native schema output only. Unknown models/providers fail closed; no JSON-mode fallback.
# Only schema statistics are sent. Approve this scope before connecting production sources.
CREAMA_PROVIDER=google
GEMINI_API_KEY=
CREAMA_MODEL=gemini-3.8-flash
CREAMA_THINKING=low
# Other enabled providers require an explicit supported CREAMA_MODEL and their own key.
# OPENAI_API_KEY=
# XAI_API_KEY=
# ANTHROPIC_API_KEY=
# DeepSeek and arbitrary compatible endpoints are NOT enabled: this integration
# must verify native schema enforcement before adding them. JSON mode is insufficient.

# Optional: the database to analyse. Without it, paste a URL in the web app.
# Use a read-only role. Creama only ever runs READ ONLY transactions.
# CREAMA_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB

# Optional: offers "try the demo database" on the connect screen (created by `pnpm demo:db`).
# CREAMA_DEMO_URL is written to .env.local by `pnpm demo:db` (password generated per machine).
# CREAMA_DEMO_URL=

# Optional: require `Authorization: Bearer <token>` on every API route.
# CREAMA_API_TOKEN=

# Required: Creama's own state (metrics, versions, audit log, users). A Postgres database it can
# write to — not the one it analyses. Tables are created on first start.
DATABASE_URL=postgresql://localhost:5432/creama

# Currency used to display money metrics (ISO code). Default VND: 1.234.567 ₫, "1,25 tỷ ₫" when compact.
# CREAMA_CURRENCY=VND

# Durable worker: pnpm worker. Scheduled schema drift checks (UTC cron, default hourly).
# Set off to disable. No model calls; alerts appear in metric state and the audit log.
# CREAMA_DRIFT_CRON=0 * * * *

# Sign-in (Better Auth). APP_URL is the address people open; MCP clients connect to APP_URL/api/mcp.
APP_URL=http://localhost:3300
BETTER_AUTH_SECRET=
# Optional Google sign-in (for emails an admin has invited).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Connection strings and passwords Creama stores (sources, servers, hosted databases) are sealed with
# this key (default: derived from BETTER_AUTH_SECRET). Keep it stable: changing it makes them unreadable.
# Servers for hosted databases are added in the app (Databases → Servers), not here.
# CREAMA_ENCRYPTION_KEY=
